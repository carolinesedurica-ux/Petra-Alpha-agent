# ==========================================
# PETRA OPTIONS ALPHA - VERCEL & SYSTEM ENV
# ==========================================

# ------------------------------------------
# 1. Execution & App Environment Settings
# ------------------------------------------
# Automatically set by Vercel in deployment, set manually if testing locally
VERCEL=1

# CORS allowed origins (use '*' or your Vercel deployment URL)
CORS_ORIGINS=*

# Agent execution cycle interval (in seconds)
AGENT_CYCLE_SECONDS=900
TICK_MAX_CANDIDATES=3

# Optional secret for authenticating automated cron trigger requests to /api/cron
CRON_SECRET=your_cron_secret_here

# ------------------------------------------
# 2. Alpaca Trading API Configuration
# ------------------------------------------
# ALPACA_MODE options: 'mock' (simulated 100k account) or 'live' (Alpaca Paper/Live API)
ALPACA_MODE=mock

# Required if ALPACA_MODE=live
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ------------------------------------------
# 3. LLM & Intelligence Provider (Featherless AI / Emergent LLM)
# ------------------------------------------
# Featherless AI API Key (Inference for Qwen / DeepSeek R1 models)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3.6-35B-A3B
FEATHERLESS_CHAT_MODEL=Qwen/Qwen2.5-32B-Instruct

# Emergent LLM Key (Fallback for Claude Sonnet)
EMERGENT_LLM_KEY=

# ------------------------------------------
# 4. Database Configuration (MongoDB)
# ------------------------------------------
# Mongo URL: Provide connection string (e.g. mongodb+srv://...)
# If left empty, system automatically uses in-memory AsyncMongoMockClient (ideal for serverless Vercel)
MONGO_URL=
DB_NAME=options_alpha

# ------------------------------------------
# 5. Frontend Environment Variables
# ------------------------------------------
# Leave empty on Vercel so API calls hit relative path '/api'
REACT_APP_BACKEND_URL=
