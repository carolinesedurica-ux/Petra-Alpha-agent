{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && yarn install --frozen-lockfile && REACT_APP_BACKEND_URL= yarn build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/**/*.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/debug",
      "destination": "/api/debug.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
